+
+// speakerRecognitionTurn 绑定一次流式录音和它的识别结果。
+type speakerRecognitionTurn struct {
+	finish sync.Once
+	result chan *speaker.IdentifyResult
+}
+
+func (s *ChatSession) startSpeakerRecognition(ctx context.Context, sampleRate int, agentID string) error {
+	s.speakerTurnMu.Lock()
+	defer s.speakerTurnMu.Unlock()
+
+	if err := s.speakerManager.StartStreaming(ctx, sampleRate, agentID); err != nil {
+		return err
+	}
+	s.speakerTurn = &speakerRecognitionTurn{result: make(chan *speaker.IdentifyResult, 1)}
+	return nil
+}
+
+func (s *ChatSession) finishSpeakerRecognition(ctx context.Context) {
+	s.speakerTurnMu.Lock()
+	defer s.speakerTurnMu.Unlock()
+
+	turn := s.speakerTurn
+	if turn == nil {
+		return
+	}
+
+	turn.finish.Do(func() {
+		go func() {
+			result, err := s.speakerManager.FinishAndIdentify(ctx)
+			if err != nil {
+				log.Warnf("获取声纹识别结果失败: %v", err)
+			} else if result != nil && result.Identified {
+				log.Infof("声纹识别完成，置信度: %.4f，阈值: %.4f", result.Confidence, result.Threshold)
+			}
+			turn.result <- result
+		}()
+	})
+}
+
+func (s *ChatSession) getSpeakerResult() *speaker.IdentifyResult {
+	s.speakerTurnMu.Lock()
+	turn := s.speakerTurn
+	s.speakerTurn = nil
+	s.speakerTurnMu.Unlock()
+	if turn == nil {
+		return nil
+	}
+
+	// 流结束后，声纹结果仍属于本轮。等待结果时不再检查流的激活状态。
+	timer := time.NewTimer(200 * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case result := <-turn.result:
+		return result
+	case <-timer.C:
+		return nil
+	}
+}
+
+func (s *ChatSession) clearPendingSpeakerResult() {
+	s.speakerTurnMu.Lock()
+	s.speakerTurn = nil
+	s.speakerTurnMu.Unlock()
+}
