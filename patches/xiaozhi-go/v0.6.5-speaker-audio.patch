@@ -0,0 +1,72 @@
+package edge
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	"github.com/go-audio/wav"
+	"github.com/gopxl/beep"
+	"xiaozhi-esp32-server-golang/internal/util"
+	log "xiaozhi-esp32-server-golang/logger"
+)
+
+// macMandarinSpeech 用系统普通话音色生成设备需要的 Opus 帧。
+func macMandarinSpeech(ctx context.Context, text string, sampleRate, frameDuration int) (<-chan []byte, error) {
+	if sampleRate <= 0 {
+		sampleRate = 16000
+	}
+	synthesisCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+
+	dir, err := os.MkdirTemp("", "xiaozhi-speech-")
+	if err != nil {
+		return nil, err
+	}
+	defer os.RemoveAll(dir)
+
+	input := filepath.Join(dir, "input.txt")
+	if err := os.WriteFile(input, []byte(text), 0600); err != nil {
+		return nil, err
+	}
+	output := filepath.Join(dir, "speech.wav")
+	cmd := exec.CommandContext(synthesisCtx, "/usr/bin/say", "-v", "Tingting", "-f", input, "-o", output,
+		"--file-format=WAVE", "--data-format=LEI16@"+strconv.Itoa(sampleRate))
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("say: %w", err)
+	}
+
+	file, err := os.Open(output)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	pcm, err := wav.NewDecoder(file).FullPCMBuffer()
+	if err != nil {
+		return nil, err
+	}
+
+	raw := make([]byte, len(pcm.Data)*2)
+	for i, sample := range pcm.Data {
+		binary.LittleEndian.PutUint16(raw[2*i:], uint16(int16(sample)))
+	}
+	frames := make(chan []byte, 100)
+	decoder, err := util.CreateAudioDecoderWithSampleRate(ctx, io.NopCloser(bytes.NewReader(raw)), frames, frameDuration, "pcm", sampleRate)
+	if err != nil {
+		return nil, err
+	}
+	decoder.WithFormat(beep.Format{SampleRate: beep.SampleRate(pcm.Format.SampleRate), NumChannels: pcm.Format.NumChannels, Precision: 2})
+	go func() {
+		if err := decoder.Run(time.Now().UnixMilli()); err != nil && ctx.Err() == nil {
+			log.Warnf("本地普通话音频编码失败: %v", err)
+		}
+	}()
+	return frames, nil
+}
