+package chat
+
+import (
+	"testing"
+
+	"xiaozhi-esp32-server-golang/internal/domain/speaker"
+)
+
+func TestCompletedSpeakerStreamStillSuppliesCurrentTurnResult(t *testing.T) {
+	turn := &speakerRecognitionTurn{result: make(chan *speaker.IdentifyResult, 1)}
+	session := &ChatSession{speakerTurn: turn}
+	match := &speaker.IdentifyResult{Identified: true, SpeakerName: "tester"}
+	turn.result <- match
+
+	if got := session.getSpeakerResult(); got != match {
+		t.Fatalf("current turn result: got %v, want %v", got, match)
+	}
+	if got := session.getSpeakerResult(); got != nil {
+		t.Fatalf("the next turn inherited %v", got)
+	}
+}
