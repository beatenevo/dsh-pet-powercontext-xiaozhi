 // TextToSpeechStream 流式合成，返回Opus帧chan
 func (p *EdgeTTSProvider) TextToSpeechStream(ctx context.Context, text string, sampleRate int, channels int, frameDuration int) (chan []byte, error) {
+	stream, err := p.streamEdge(ctx, text, frameDuration)
+	if runtime.GOOS != "darwin" || !strings.HasPrefix(p.Voice, "zh-CN-") {
+		return stream, err
+	}
+	output := make(chan []byte, 100)
+	go func() {
+		defer close(output)
+		if err == nil && forwardSpeechFrames(ctx, stream, output) {
+			return
+		}
+		if ctx.Err() != nil {
+			return
+		}
+		fallback, err := macMandarinSpeech(ctx, text, sampleRate, frameDuration)
+		if err != nil {
+			if ctx.Err() == nil {
+				log.Warnf("本地普通话合成失败: %v", err)
+			}
+			return
+		}
+		if forwardSpeechFrames(ctx, fallback, output) {
+			log.Info("本地普通话已生成备用播报音频")
+		}
+	}()
+	return output, nil
+}
+
+func forwardSpeechFrames(ctx context.Context, input <-chan []byte, output chan<- []byte) bool {
+	sent := false
+	for {
+		select {
+		case <-ctx.Done():
+			return sent
+		case frame, open := <-input:
+			if !open {
+				return sent
+			}
+			select {
+			case <-ctx.Done():
+				return sent
+			case output <- frame:
+				sent = true
+			}
+		}
+	}
+}
