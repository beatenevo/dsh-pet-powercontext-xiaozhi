+package edge
+
+import (
+	"context"
+	"os/exec"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"gopkg.in/hraban/opus.v2"
+)
+
+func TestMacMandarinSpeechProducesDeviceFrames(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("requires macOS speech synthesis")
+	}
+	voices, err := exec.Command("/usr/bin/say", "-v", "?").Output()
+	if err != nil || !strings.Contains(string(voices), "Tingting") {
+		t.Skip("requires the Tingting voice")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	const rate = 24000
+	const frameSamples = rate * 60 / 1000
+	frames, err := macMandarinSpeech(ctx, "语音播报测试。", rate, 60)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoder, err := opus.NewDecoder(rate, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pcm := make([]int16, frameSamples)
+	count := 0
+	audible := false
+	for frame := range frames {
+		n, err := decoder.Decode(frame, pcm)
+		if err != nil || n != frameSamples {
+			t.Fatalf("invalid device frame: %d samples, %v", n, err)
+		}
+		for _, sample := range pcm[:n] {
+			audible = audible || sample > 300 || sample < -300
+		}
+		count++
+	}
+	if count == 0 || !audible {
+		t.Fatalf("expected audible Opus speech, generated %d frames", count)
+	}
+}
